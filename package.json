{
  "name": "canvas-author-code",
  "displayName": "Canvas Author",
  "description": "Author and sync Canvas LMS content from VS Code",
  "version": "0.1.0",
  "publisher": "lucidbard",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucidbard/canvas-author-code"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.canvas.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "canvas-author.init",
        "title": "Canvas: Initialize Course"
      },
      {
        "command": "canvas-author.pull",
        "title": "Canvas: Pull Pages"
      },
      {
        "command": "canvas-author.push",
        "title": "Canvas: Push Pages"
      },
      {
        "command": "canvas-author.status",
        "title": "Canvas: Show Sync Status"
      },
      {
        "command": "canvas-author.listCourses",
        "title": "Canvas: List Courses"
      },
      {
        "command": "canvas-author.pullModules",
        "title": "Canvas: Pull Modules"
      },
      {
        "command": "canvas-author.pushModules",
        "title": "Canvas: Push Modules"
      },
      {
        "command": "canvas-author.moduleStatus",
        "title": "Canvas: Show Module Status"
      }
    ],
    "configuration": {
      "title": "Canvas Author",
      "properties": {
        "canvas-author.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python interpreter with canvas-mcp installed"
        },
        "canvas-author.canvasDomain": {
          "type": "string",
          "default": "",
          "description": "Canvas LMS domain (e.g., canvas.instructure.com)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.54.0",
    "mocha": "^10.2.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0"
  }
}
